<style>
/* Layout: banda negra con logo, hero corto, catálogo en cuadrícula y carrito en una tarjeta aparte. Negro y dorado de la marca. */
:root {
  --bg: #f4f4f2;
  --surface: #ffffff;
  --fg: #181818;
  --muted: #6a6a66;
  --line: #dcdcd7;
  --accent: #e5b13d;
  --accent-ink: #151515;
  --band: #111111;
  --band-fg: #ffffff;
  --tile: #ececE8;
  --danger: #b3261e;
  --font-display: "Space Grotesk", "Arial Narrow", Arial, sans-serif;
  --font-body: "Inter", Arial, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0e0e0e; --surface: #1a1a19; --fg: #f1f1ee; --muted: #a2a29c; --line: #333330;
    --band: #000000; --tile: #262624; --danger: #ff8a80; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0e0e0e; --surface: #1a1a19; --fg: #f1f1ee; --muted: #a2a29c; --line: #333330;
  --band: #000000; --tile: #262624; --danger: #ff8a80; color-scheme: dark;
}

* { box-sizing: border-box; }
body { margin: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 76px; }
body { background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 16px; line-height: 1.5; }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 30; background: var(--band); }
h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; line-height: 1.1; }
button, select, input { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

.wrap { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.wrap > .in { max-width: 1120px; margin: 0 auto; }

/* Cabecera */
header { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--band); color: var(--band-fg); }
header .in { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-block: 14px; }
.logo { font-family: var(--font-display); font-weight: 700; font-size: 24px; letter-spacing: 0.22em; }
nav { display: flex; gap: 20px; align-items: center; }
nav a { color: var(--band-fg); text-decoration: none; font-size: 15px; }
nav a:hover { color: var(--accent); }
